{
  "name": "infinize-ucc-connect-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Infinize Unified Contact Center (UCC) \u00e2\u20ac\u201d Amazon Connect + Amazon Bedrock reference POC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/ucc-web",
    "infrastructure/cdk"
  ],
  "scripts": {
    "dev": "tsx watch apps/ucc-api/src/main.ts",
    "start": "tsx apps/ucc-api/src/main.ts",
    "dev:web": "npm run dev --workspace @ucc/web",
    "build:web": "npm run build --workspace @ucc/web",
    "seed": "tsx scripts/seed.ts",
    "kb:ingest": "tsx scripts/ingest-kb.ts",
    "demo": "tsx scripts/run-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:security": "vitest run tests/security",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cdk:synth": "npm run synth --workspace @ucc/infrastructure",
    "cdk:deploy": "npm run deploy --workspace @ucc/infrastructure",
    "cdk:synth:connect": "npm --prefix infrastructure/cdk run synth:connect",
    "cdk:deploy:connect": "npm --prefix infrastructure/cdk run deploy:connect"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.717.0",
    "@aws-sdk/client-connect": "^3.717.0",
    "@aws-sdk/client-dynamodb": "^3.717.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-ssm": "^3.717.0",
    "@aws-sdk/lib-dynamodb": "^3.717.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "^3.1112.0",
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}