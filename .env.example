# Infinize UCC Connect POC — configuration template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# AWS credentials are NOT read from this file: use an IAM role in deployment, or a named
# AWS CLI profile locally (AWS_PROFILE). Do not put access keys here.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
# Use a named profile locally instead of embedding keys:
# AWS_PROFILE=ucc-poc

# --- Persistence -------------------------------------------------------------
# memory | dynamodb
UCC_PERSISTENCE=memory
# Required when UCC_PERSISTENCE=dynamodb (output of the CDK stack)
# UCC_TABLE_NAME=ucc-poc-table

# --- Storage -----------------------------------------------------------------
# Private bucket for recordings and the KB vector index (output of the CDK stack)
# UCC_BUCKET_NAME=ucc-poc-artifacts-<account>-<region>

# --- Bedrock -----------------------------------------------------------------
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# bedrock = live Titan embeddings; lexical = offline deterministic fallback
UCC_RETRIEVAL=bedrock

# --- Telephony ---------------------------------------------------------------
# connect | simulated
# `connect` requires an Amazon Connect instance. See docs/deployment.md — instance
# creation is currently blocked in this AWS account by an organisation SCP (ADR-0004).
UCC_TELEPHONY=simulated
# CONNECT_INSTANCE_ID=
# CONNECT_CONTACT_FLOW_ID=
# CONNECT_SOURCE_PHONE_NUMBER=

# --- Security ----------------------------------------------------------------
# Salt for hashing verification codes. In deployment this comes from SSM/Secrets Manager.
VERIFICATION_SALT=change-me-in-deployment

# --- Tenant ------------------------------------------------------------------
DEFAULT_TENANT_ID=infinize-university

# --- Voice pipeline (services/voice-pipecat) --------------------------------
# Which pipeline carries the AI leg on the UCC side. Distinct from UCC_PIPELINE_MODE
# below: this one chooses WHO runs the voice leg, that one chooses HOW.
# conversationrelay | pipecat
UCC_VOICE=conversationrelay
# Public wss URL of the Pipecat service. Required when UCC_VOICE=pipecat.
# PIPECAT_WS_URL=wss://<voice-tunnel-host>/ws

# Shared credential proving a caller of the voice bridge IS the voice service.
# The SAME value must be set on the UCC API and on the Pipecat service; the service
# checks it against UCC at startup and refuses to start on a mismatch.
# Generate a long random value. Never commit the real one.
# UCC_VOICE_SERVICE_TOKEN=

# --- Pipecat service only ----------------------------------------------------
# Pipeline topology. cascaded = Transcribe -> Bedrock -> Polly (each stage swappable);
# s2s = Amazon Nova Sonic speech-to-speech. An invalid value refuses to start.
UCC_PIPELINE_MODE=cascaded
# Per-stage providers, cascaded only. Enum exists so a swap is config, not code.
UCC_STT_PROVIDER=aws
UCC_LLM_PROVIDER=bedrock
UCC_TTS_PROVIDER=aws
# s2s only. Must be nova-2-sonic: v1 never emitted a tool request in testing, which
# would restrict the assistant to public FAQ answers.
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE=tiffany
# Where the Pipecat service reaches the UCC API.
UCC_API_BASE=http://localhost:4000
